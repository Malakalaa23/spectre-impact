# AI providers (Groq -> OpenAI -> Anthropic by default)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
SPECTRE_AI_PROVIDERS=groq,openai,anthropic

# Optional GitHub webhook protection
GITHUB_WEBHOOK_SECRET=

# Optional persistent paths
SPECTRE_VOICE_CACHE=.spectre/voice_cache
SPECTRE_CHROMA_PATH=.spectre/chroma
SPECTRE_CHROMA_COLLECTION=spectre_impact
REDIS_URL=
